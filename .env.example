# Reference only: npm start does not load .env automatically.
# Inject independently generated secrets via the process environment; never commit them.
PORT=8080
DEMO_ACCESS_KEY=
MCP_ACCESS_KEY=
PUBLIC_ORIGIN=http://localhost:8080
# Native MCP requires all Entra fields, plus an HTTPS PUBLIC_ORIGIN.
# When Entra is configured, MCP_ACCESS_KEY cannot bypass OAuth.
# MCP_ENTRA_TENANT_ID=<tenant-guid>
# MCP_ENTRA_CLIENT_ID=<registered-api-and-client-guid>
# MCP_ENTRA_ALLOWED_OIDS=<authorized-user-object-guid>
# MCP_ENTRA_SCOPE=access_as_user
# Local development only; Azure app/job use Blob RBAC, without a filesystem mount.
STATE_PATH=.runtime/state.json
# Leave these UNSET locally, not empty: partial Azure configuration fails closed.
# Uncomment and fill each group for cloud. Never use model/storage API keys.
# AZURE_CLIENT_ID=<managed-identity-client-id>
# AZURE_STORAGE_ACCOUNT=<storage-account-name>
# AZURE_STORAGE_CONTAINER=demo-state
# AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=teacher-reasoning
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
AUTOPILOT_SCHEDULE=06:30 em dias uteis (America/Sao_Paulo)
